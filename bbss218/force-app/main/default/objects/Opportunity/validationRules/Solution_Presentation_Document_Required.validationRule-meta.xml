<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Solution_Presentation_Document_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Solution Presentation&quot;),
    ISBLANK(Presentation_deck_link__c)
)</errorConditionFormula>
    <errorMessage>&quot;Please provide the Presentation Document Link when moving to Solution Presentation stage.&quot;</errorMessage>
</ValidationRule>
