<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unqualified_Reason_Code_for_UnQualified</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status, &quot;Unqualified&quot;),
ISBLANK(   Unqualified_Reason__c )
)</errorConditionFormula>
    <errorDisplayField>Unqualified_Reason__c</errorDisplayField>
    <errorMessage>is mandatory when moving Stage from Nurturing to Unqualified.</errorMessage>
</ValidationRule>
