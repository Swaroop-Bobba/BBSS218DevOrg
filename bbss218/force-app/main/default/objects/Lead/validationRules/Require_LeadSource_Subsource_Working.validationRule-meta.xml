<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_LeadSource_Subsource_Working</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Working&quot;),
    OR(
        ISBLANK(TEXT(LeadSource)),
        ISBLANK(TEXT(Lead_Sub_Source__c))
    )
)</errorConditionFormula>
    <errorMessage>&quot;Lead Source and Subsource must be filled before moving to Working status.&quot;</errorMessage>
</ValidationRule>
