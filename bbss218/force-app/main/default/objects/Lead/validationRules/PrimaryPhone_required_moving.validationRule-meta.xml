<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PrimaryPhone_required_moving</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Working&quot;),
    ISBLANK( Primary_Phone__c )
)</errorConditionFormula>
    <errorDisplayField>Primary_Phone__c</errorDisplayField>
    <errorMessage>is required before moving the Lead to Working status.</errorMessage>
</ValidationRule>
