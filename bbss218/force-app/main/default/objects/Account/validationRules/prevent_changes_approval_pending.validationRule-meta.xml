<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>prevent_changes_approval_pending</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL( Account_Approval_Status__c , &quot;Pending&quot;),
    ISCHANGED( AnnualRevenue )
)</errorConditionFormula>
    <errorDisplayField>AnnualRevenue</errorDisplayField>
    <errorMessage>You cannot update Annual Revenue while the Account Approval Status is Pending.</errorMessage>
</ValidationRule>
